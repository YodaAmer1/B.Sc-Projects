# --- PostgreSQL (reference; app uses DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opendoordb
DB_USER=opendooruser
DB_PASSWORD=opendoorpass

# --- Database (required for app + Alembic) ---
DATABASE_URL=postgresql+asyncpg://opendooruser:opendoorpass@localhost:5432/opendoordb
JWT_SECRET=a-string-secret-at-least-256-bits-long
# JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
